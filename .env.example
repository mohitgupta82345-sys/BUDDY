# Server & Security
PORT=3001
JWT_SECRET=replace-with-a-unique-random-secret

# Database (PostgreSQL)
# When set and reachable, BUDDY automatically connects and runs schema migrations.
# Local file storage is development-only; production requires a working DATABASE_URL.
# Remote PostgreSQL connections use verified TLS.
DATABASE_URL=

# AI Career Recommendation Engine (Google Gemini)
# Optional: If configured, BUDDY calls real Gemini 2.5 models for deep qualitative analysis.
# If omitted, BUDDY uses its transparent deterministic rule-based engine.
GEMINI_API_KEY=

# Client
VITE_API_BASE_URL=http://localhost:5173
